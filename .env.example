# auth-ui environment — copy to .env and fill in. .env is gitignored; never commit real secrets.
#
# The Zod schema in app/server/infra/env.server.ts is the source of truth. It is parsed ONCE at
# boot, so a missing/invalid required var fails the process at startup, not at first request.
# Full reference (defaults, fail-closed behaviour): docs/operations/configuration.md
#
# Two provider modes, selected by AUTH_PROVIDER:
#   fake    — in-memory FakeAuthProvider. No Zitadel needed. Used for local dev and the
#             Cypress fast e2e suite. Only SESSION_SECRET is required.
#   zitadel — real Zitadel via the Session API. Requires ZITADEL_API_URL and
#             ZITADEL_SERVICE_USER_TOKEN; PUBLIC_ORIGIN is required in production.
# ─────────────────────────────────────────────────────────────────────────────

# ── Always required ──────────────────────────────────────────────────────────
# Session-cookie signing key (HMAC-SHA256). MUST be at least 32 characters.
# Generate: openssl rand -base64 32
SESSION_SECRET=change-me-to-a-long-random-secret-min-32-chars


# ── Development ──────────────────────────────────────────────────────────────
# Application environment: development | production | test  (default: development)
NODE_ENV=development

# Provider selector: fake | zitadel. Any value other than 'fake' uses the Zitadel adapter,
# so the ZITADEL_* requirements below apply whenever this is unset or 'zitadel'.
AUTH_PROVIDER=fake


# ── FAKE provider (AUTH_PROVIDER=fake) ───────────────────────────────────────
# Nothing else is required. The in-memory provider seeds its own users
# (e.g. alice@acme.test / hunter2). Leave the ZITADEL_* and PUBLIC_ORIGIN vars unset.


# ── ZITADEL provider — required in production ────────────────────────────────
# Commented out below because AUTH_PROVIDER=fake (above) doesn't need them. Uncomment and fill
# in when switching to AUTH_PROVIDER=zitadel (or pointing at the local handbook Zitadel stack).

# Base URL of the Zitadel OIDC/API server.
#   local handbook stack: https://auth.localtest.me:30000
#   defaults to http://localhost:8080 when unset
# ZITADEL_API_URL=https://auth.localtest.me:30000

# Service-user PAT for all server-to-server Zitadel calls. SECRET — never commit a real value.
#   local: kubectl get secret zitadel-login-client -n datum-iam-system -o jsonpath='{.data.pat}' | base64 -d
# ZITADEL_SERVICE_USER_TOKEN=

# Trusted public origin (scheme + host) used to build verification/reset email links.
# MUST come from config, never the request Host header (host-header injection). REQUIRED in
# production with the Zitadel provider; the boot guard rejects a 'REPLACE_ME' placeholder.
#   local: http://localhost:3000  (the origin the browser reaches auth-ui on)
# PUBLIC_ORIGIN=http://localhost:3000

# Local dev only — trust the handbook Zitadel's self-signed CA so Node's TLS can reach it.
# Not part of the app's env schema (it is a Node runtime var). Point at your stack's CA file.
# NODE_EXTRA_CA_CERTS=/path/to/zitadel-local-ca.pem


# ── Zitadel transport (optional) ─────────────────────────────────────────────
# Comma-separated allowlist for the x-zitadel-forward-host header.
# Unset/empty = reject ALL forward-host overrides (fail-closed).
# ZITADEL_TRUSTED_FORWARD_HOSTS=tenant1.zitadel.example.com,tenant2.zitadel.example.com

# Extra headers injected on EVERY outbound Zitadel API request (Connect interceptor).
# Format: comma-separated Key:Value pairs. Use when auth-ui reaches Zitadel via an internal
# address but Zitadel must mint public-facing URLs (OIDC issuer, SAML metadata/ACS, redirects).
# Unset = no extra headers.
# ZITADEL_CUSTOM_REQUEST_HEADERS=x-zitadel-public-host:auth.datum.net,x-zitadel-public-proto:https

# Ops pin for the org-first fallback (resolveOrg). When set, a login with no explicit
# ?organization= (and no OIDC org-id scope) uses THIS org id instead of the provider's default
# org lookup. Unset = the Zitadel instance Default Organization. Display-only. See ADR 005.
# ZITADEL_DEFAULT_ORG_ID=


# ── Feature flags (all default OFF, fail-closed) ─────────────────────────────
# Only the exact string 'true' enables these (AUTH_EMAIL_DELIVERY_ENABLED also accepts '1').
# The three ALLOW_IDP_* flags are explained in ADR 004.

# Set to "true" only where email delivery works (BE/infra email path). Unset/false hides
# the email sign-in link + password-reset (fail-safe; Zitadel SMTP is NOT the signal here).
# AUTH_EMAIL_DELIVERY_ENABLED=false

# Require email verification on signup. Unset/false = verification is skipped.
# KNOWN GAP: read raw from process.env in app/server/env.ts — NOT in the validated Zod schema,
# so it has no typed default and a typo silently means "off". See docs/operations/configuration.md.
# EMAIL_VERIFICATION=false

# Auto-link an external IdP identity into an existing same-email account during login/register.
# Unset/false => a same-email collision is a hard `account-exists` error and the owner must link
# the IdP from the signed-in /sso screen instead.
# ALLOW_IDP_AUTO_LINK=false

# Let the EXPLICIT SSO link ceremony attach a FRESH external identity regardless of its email.
# Unset/false => strict gate: the IdP-verified email must already be owned by the session user.
# ALLOW_IDP_LINK_ANY_EMAIL=false

# Permit unlinking an identity provider from an account. Unset/false => unlink is refused.
# ALLOW_IDP_UNLINK=false


# ── Routing (optional) ───────────────────────────────────────────────────────
# Fallback post-login destination when the request carries no ?redirect param.
# DEFAULT_APP_URL=http://localhost:3001

# Comma-separated list of allowed absolute origins for the OIDC RP-initiated logout
# post_logout_redirect target (the URL auth-ui redirects to after completing logout). Unset =>
# only same-origin relative paths are permitted (fail-closed open-redirect guard).
# POST_LOGOUT_ALLOWLIST=http://localhost:3001


# ── Security (optional) ──────────────────────────────────────────────────────
# CSP `frame-ancestors` allowlist: space- or comma-separated full origins. Unset, empty, wildcard,
# or unparseable all collapse to 'none' (the auth UI is not embeddable). X-Frame-Options is kept
# in lock-step (DENY while framing is locked down). A bare `*` is rejected outright.
# FRAME_ANCESTORS=https://staging.portal.example.com


# ── Observability (optional, both providers) ─────────────────────────────────
# Sentry error monitoring + distributed tracing. Unset = disabled (true no-op at boot).
# In production, provision these via the auth-ui Kubernetes Secret (secretRef: auth-ui).
# SENTRY_DSN must be a valid https DSN when set; an invalid value fails fast at startup.
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# SENTRY_TRACES_SAMPLE_RATE=0.1

# Fathom analytics site id. Unset = analytics is a true no-op everywhere. Exposure to the
# client is additionally prod-gated server-side (see resolveFathomSiteId): dev/preview never
# contact Fathom even when this IS set, so leave it unset locally.
# In production, provision via the auth-ui Kubernetes Secret/ConfigMap.
# FATHOM_ID=ABCDEFGH

# MaxMind minFraud device-fingerprinting account id (signup device-tracking token → Zitadel
# session metadata). Optional in EVERY environment (staging may want fraud detection too).
# Unset = the signup MaxMind tracker is a true no-op (no device.js loaded, no token captured).
# MAXMIND_ACCOUNT_ID=123456
