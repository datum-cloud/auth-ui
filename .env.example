# auth-ui environment — copy to .env and fill in. .env is gitignored; never commit real secrets.
#
# Two provider modes, selected by AUTH_PROVIDER:
#   fake    — in-memory FakeAuthProvider. No Zitadel needed. Used for local dev and the
#             Cypress fast e2e suite. Only SESSION_SECRET is required.
#   zitadel — real Zitadel via the Session API. Requires ZITADEL_API_URL and
#             ZITADEL_SERVICE_USER_TOKEN; PUBLIC_ORIGIN is required in production.
# ─────────────────────────────────────────────────────────────────────────────

# ── Always required ──────────────────────────────────────────────────────────
# Session-cookie signing key (HMAC-SHA256). MUST be at least 32 characters.
# Generate: openssl rand -base64 32
SESSION_SECRET=change-me-to-a-long-random-secret-min-32-chars

# Application environment: development | production | test  (default: development)
NODE_ENV=development

# Provider selector: fake | zitadel. Any value other than 'fake' uses the Zitadel adapter,
# so the ZITADEL_* requirements below apply whenever this is unset or 'zitadel'.
AUTH_PROVIDER=fake


# ── FAKE provider (AUTH_PROVIDER=fake) ───────────────────────────────────────
# Nothing else is required. The in-memory provider seeds its own users
# (e.g. alice@acme.test / hunter2). Leave the ZITADEL_* and PUBLIC_ORIGIN vars unset.


# ── ZITADEL provider (AUTH_PROVIDER=zitadel) ─────────────────────────────────
# Base URL of the Zitadel OIDC/API server.
#   local handbook stack: https://auth.localtest.me:30000
#   defaults to http://localhost:8080 when unset
ZITADEL_API_URL=https://auth.localtest.me:30000

# Service-user PAT for all server-to-server Zitadel calls. SECRET — never commit a real value.
#   local: kubectl get secret zitadel-login-client -n datum-iam-system -o jsonpath='{.data.pat}' | base64 -d
ZITADEL_SERVICE_USER_TOKEN=

# Trusted public origin (scheme + host) used to build verification/reset email links.
# MUST come from config, never the request Host header (host-header injection). REQUIRED in
# production with the Zitadel provider; the boot guard rejects a 'REPLACE_ME' placeholder.
#   local: http://localhost:3000  (the origin the browser reaches auth-ui on)
PUBLIC_ORIGIN=http://localhost:3000

# Local dev only — trust the handbook Zitadel's self-signed CA so Node's TLS can reach it.
# Not part of the app's env schema (it is a Node runtime var). Point at your stack's CA file.
# NODE_EXTRA_CA_CERTS=/path/to/zitadel-local-ca.pem

# Optional — fallback post-login destination when the request carries no ?redirect param.
# DEFAULT_APP_URL=http://localhost:3001

# EL-TRANSPORT-1: comma-separated allowlist for the x-zitadel-forward-host header.
# Unset/empty = reject ALL forward-host overrides (fail-closed).
# ZITADEL_TRUSTED_FORWARD_HOSTS=tenant1.zitadel.example.com,tenant2.zitadel.example.com

# Extra headers injected on EVERY outbound Zitadel API request (Connect interceptor).
# Format: comma-separated Key:Value pairs. Use when auth-ui reaches Zitadel via an internal
# address but Zitadel must mint public-facing URLs (OIDC issuer, SAML metadata/ACS, redirects).
# ZITADEL_CUSTOM_REQUEST_HEADERS=x-zitadel-public-host:auth.datum.net,x-zitadel-public-proto:https


# ── Observability (optional, both providers) ─────────────────────────────────
# Sentry error monitoring + distributed tracing. Unset = disabled (true no-op at boot).
# In production, provision these via the auth-ui Kubernetes Secret (secretRef: auth-ui).
# SENTRY_DSN must be a valid https DSN when set; an invalid value fails fast at startup.
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# SENTRY_TRACES_SAMPLE_RATE=0.1
