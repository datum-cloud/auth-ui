{
  "name": "auth-ui",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.23.0",
  "scripts": {
    "build": "react-router build",
    "dev": "node --conditions=development ./node_modules/.bin/react-router dev",
    "start": "NODE_ENV=production node ./build/server/index.js",
    "lint": "eslint \"app/**/*.{ts,tsx}\" --fix",
    "lint:ci": "eslint \"app/**/*.{ts,tsx}\"",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "prepare": "lefthook install || true",
    "typecheck": "react-router typegen && ./node_modules/typescript-native/bin/tsc",
    "typecheck:watch": "react-router typegen && ./node_modules/typescript-native/bin/tsc --noEmit --watch",
    "typecheck:cypress": "tsc -p cypress/tsconfig.json --noEmit",
    "i18n:extract": "lingui extract --clean",
    "i18n:compile": "lingui compile --typescript",
    "test:unit": "CYPRESS=true cypress run --component",
    "test:unit:debug": "CYPRESS=true cypress open --component",
    "test:e2e": "start-server-and-test \"pnpm dev\" http-get://localhost:3000/healthz \"cypress run\"",
    "test:e2e:fast": "bash scripts/e2e-fast.sh",
    "test:acceptance": "cypress run --spec acceptance/core-signin.acceptance.cy.ts",
    "size": "size-limit",
    "lint:boundaries": "depcruise app --config .dependency-cruiser.cjs",
    "lint:cycles": "madge --circular --extensions ts,tsx app"
  },
  "dependencies": {
    "@bufbuild/protobuf": "catalog:",
    "@conform-to/react": "1.21.3",
    "@conform-to/zod": "1.21.3",
    "@datum-cloud/datum-ui": "^3.8.0",
    "@epic-web/client-hints": "^1.3.9",
    "@hono/node-server": "catalog:",
    "@lingui/core": "^6.9.0",
    "@lingui/detect-locale": "^6.9.0",
    "@lingui/react": "^6.9.0",
    "@oslojs/crypto": "^1.0.1",
    "@oslojs/encoding": "^1.1.0",
    "@react-router/node": "^8.5.1",
    "@sentry/react-router": "^11.2.0",
    "@tanstack/react-virtual": "^3.14.13",
    "@zitadel/client": "1.3.1",
    "@zitadel/proto": "1.3.1",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "disposable-email-domains-js": "2.4.0",
    "hono": "4.13.22",
    "isbot": "^5.2.2",
    "js-yaml": "^5.4.2",
    "lucide-react": "^1.49.0",
    "motion": "^13.5.1",
    "prom-client": "^15.1.3",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.0",
    "react-router": "^8.5.1",
    "react-router-hono-server": "^4.1.4",
    "remix-utils": "10.0.1",
    "sonner": "^2.0.8",
    "zod": "^4.6.6"
  },
  "size-limit": [
    {
      "name": "landing page (gzip)",
      "path": [
        "build/client/assets/entry.client-*.js",
        "build/client/assets/root-*.js"
      ],
      "limit": "150 KB",
      "gzip": true
    },
    {
      "name": "app page (gzip)",
      "path": [
        "build/client/assets/entry.client-*.js",
        "build/client/assets/root-*.js",
        "build/client/assets/chunk-*.js",
        "build/client/assets/form-*.js",
        "build/client/assets/schemas-*.js"
      ],
      "limit": "300 KB",
      "gzip": true
    }
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lingui/cli": "^6.9.0",
    "@lingui/vite-plugin": "^6.9.0",
    "@react-router/dev": "^8.5.1",
    "@simplewebauthn/server": "^14.0.3",
    "@size-limit/file": "^14.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/cypress": "^10.1.3",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "axe-core": "^4.13.0",
    "cypress": "catalog:",
    "cypress-axe": "^1.7.0",
    "cypress-split": "^1.25.0",
    "dependency-cruiser": "^18.5.0",
    "eslint": "^10.11.0",
    "lefthook": "^2.1.16",
    "madge": "^8.0.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "size-limit": "^14.1.0",
    "start-server-and-test": "^3.0.12",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "catalog:",
    "typescript-eslint": "^8.71.0",
    "typescript-native": "npm:typescript@^7.0.2",
    "vite": "^8.3.3",
    "vite-plugin-babel-macros": "^1.0.6"
  }
}
