{
  "name": "auth-ui",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "bunx --bun react-router dev",
    "start": "NODE_ENV=production bun ./build/server/index.js",
    "lint": "bunx eslint \"app/**/*.{ts,tsx}\" --fix",
    "lint:ci": "bunx eslint \"app/**/*.{ts,tsx}\"",
    "format": "bunx prettier --write \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "prepare": "lefthook install || true",
    "typecheck": "bunx react-router typegen && tsc",
    "i18n:extract": "lingui extract --clean",
    "i18n:compile": "lingui compile --typescript",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "start-server-and-test 'bun run dev' http-get://localhost:3000/healthz 'bunx cypress run'",
    "test:e2e:fast": "bun run build && AUTH_PROVIDER=fake start-server-and-test 'bun run start' http-get://localhost:3000/healthz 'bunx cypress run --spec cypress/e2e/core-signin.cy.ts'",
    "test:acceptance": "bunx cypress run --spec acceptance/core-signin.acceptance.cy.ts",
    "size": "size-limit",
    "lint:boundaries": "depcruise app --config .dependency-cruiser.cjs",
    "lint:cycles": "madge --circular --extensions ts,tsx app",
    "test:coverage": "vitest run --coverage",
    "test:visual": "playwright test -c playwright.visual.config.ts"
  },
  "dependencies": {
    "@conform-to/react": "1.19.3",
    "@conform-to/zod": "1.19.3",
    "@datum-cloud/datum-ui": "^1.2.0",
    "@epic-web/client-hints": "^1.3.9",
    "@lingui/core": "^6.0.0",
    "@lingui/detect-locale": "^6.0.0",
    "@lingui/react": "^6.0.0",
    "@opentelemetry/core": "^2.8.0",
    "@opentelemetry/sdk-trace-base": "^2.8.0",
    "@oslojs/crypto": "^1.0.1",
    "@oslojs/encoding": "^1.1.0",
    "@react-router/node": "^7.12.0",
    "@sentry/react-router": "^10.58.0",
    "@zitadel/client": "1.3.1",
    "@zitadel/proto": "1.3.1",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "fathom-client": "^3.7.2",
    "hono": "4.12.25",
    "ioredis": "^5.11.1",
    "isbot": "^5.1.27",
    "js-yaml": "^4.2.0",
    "lucide-react": "^1.0.0",
    "prom-client": "^15.1.3",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.3",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.3",
    "react-router": "^7.12.0",
    "react-router-hono-server": "^2.13.0",
    "remix-utils": "8.8.0",
    "sonner": "^2.0.7",
    "zod": "^4.3.6"
  },
  "overrides": {
    "@opentelemetry/sdk-trace-base": "2.8.0",
    "@opentelemetry/core": "2.8.0",
    "@opentelemetry/resources": "2.8.0",
    "undici": "^7.28.0",
    "form-data": "^4.0.6",
    "dompurify": "^3.4.11",
    "esbuild": "^0.28.1"
  },
  "size-limit": [
    {
      "name": "first-load JS (gzip)",
      "path": [
        "build/client/assets/entry.client-*.js",
        "build/client/assets/root-*.js",
        "build/client/assets/chunk-*.js",
        "build/client/assets/form-*.js",
        "build/client/assets/schemas-*.js"
      ],
      "limit": "300 KB",
      "gzip": true
    }
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lingui/cli": "^6.0.0",
    "@lingui/vite-plugin": "^6.0.0",
    "@playwright/test": "^1.61.0",
    "@react-router/dev": "^7.12.0",
    "@size-limit/file": "^12.1.0",
    "@tailwindcss/vite": "^4.1.6",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/bun": "^1.2.13",
    "@types/react": "^19.1.3",
    "@types/react-dom": "^19.1.3",
    "@vitest/coverage-v8": "^4.1.9",
    "axe-core": "^4.12.1",
    "cypress": "^15.0.0",
    "cypress-axe": "^1.7.0",
    "dependency-cruiser": "^17.4.3",
    "eslint": "^10.0.0",
    "happy-dom": "^20.0.7",
    "lefthook": "^2.1.6",
    "madge": "^8.0.0",
    "playwright": "^1.60.0",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "size-limit": "^12.1.0",
    "start-server-and-test": "^3.0.0",
    "tailwindcss": "^4.1.6",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.61.0",
    "vite": "^8.0.0",
    "vite-plugin-babel-macros": "^1.0.6",
    "vitest": "^4.1.0"
  }
}
