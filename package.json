{
  "name": "auth-ui",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "bunx --bun react-router dev",
    "start": "NODE_ENV=production bun ./build/server/index.js",
    "lint": "bunx eslint \"app/**/*.{ts,tsx}\" --fix",
    "lint:ci": "bunx eslint \"app/**/*.{ts,tsx}\"",
    "format": "bunx prettier --write \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "typecheck": "bunx react-router typegen && tsc",
    "i18n:extract": "lingui extract --clean",
    "i18n:compile": "lingui compile --typescript",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "start-server-and-test 'bun run dev' http-get://localhost:3000/healthz 'bunx cypress run'",
    "test:e2e:fast": "AUTH_PROVIDER=fake start-server-and-test 'bun run dev' http-get://localhost:3000/healthz 'bunx cypress run --spec cypress/e2e/core-signin.cy.ts'",
    "test:acceptance": "bunx cypress run --spec acceptance/core-signin.acceptance.cy.ts",
    "size": "size-limit",
    "perf:lhci": "lhci autorun --config=./lighthouserc.json"
  },
  "dependencies": {
    "@conform-to/react": "1.19.3",
    "@conform-to/zod": "1.19.3",
    "@datum-cloud/datum-ui": "^1.2.0",
    "@lingui/core": "^6.0.0",
    "@lingui/detect-locale": "^6.0.0",
    "@lingui/react": "^6.0.0",
    "@oslojs/crypto": "^1.0.1",
    "@oslojs/encoding": "^1.1.0",
    "@react-router/node": "^7.12.0",
    "@sentry/react-router": "^10.5.0",
    "@tanstack/react-query": "^5.80.3",
    "@tanstack/react-virtual": "^3.14.2",
    "@zitadel/client": "1.3.1",
    "@zitadel/proto": "1.3.1",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "hono": "4.12.25",
    "isbot": "^5.1.27",
    "lucide-react": "^1.0.0",
    "prom-client": "^15.1.3",
    "react": "^19.2.3",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.3",
    "react-router": "^7.12.0",
    "react-router-hono-server": "^2.13.0",
    "remix-utils": "8.8.0",
    "sonner": "^2.0.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@lingui/cli": "^6.0.0",
    "@lingui/vite-plugin": "^6.0.0",
    "@react-router/dev": "^7.12.0",
    "@size-limit/preset-app": "^12.1.0",
    "@tailwindcss/vite": "^4.1.6",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/bun": "^1.2.13",
    "@types/react": "^19.1.3",
    "@types/react-dom": "^19.1.3",
    "axe-core": "^4.12.1",
    "cypress": "^15.0.0",
    "cypress-axe": "^1.7.0",
    "eslint": "^10.0.0",
    "happy-dom": "^20.0.7",
    "playwright": "^1.60.0",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "size-limit": "^12.1.0",
    "start-server-and-test": "^3.0.0",
    "tailwindcss": "^4.1.6",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.61.0",
    "vite": "^8.0.0",
    "vite-plugin-babel-macros": "^1.0.6",
    "vitest": "^4.1.0"
  }
}
