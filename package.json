{
  "name": "auth-ui",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "bunx --bun react-router dev",
    "start": "NODE_ENV=production bun ./build/server/index.js",
    "lint": "bunx eslint \"app/**/*.{ts,tsx}\" --fix",
    "lint:ci": "bunx eslint \"app/**/*.{ts,tsx}\"",
    "format": "bunx prettier --write \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "prepare": "lefthook install || true",
    "typecheck": "bunx react-router typegen && tsc",
    "typecheck:cypress": "tsc -p cypress/tsconfig.json --noEmit",
    "i18n:extract": "lingui extract --clean",
    "i18n:compile": "lingui compile --typescript",
    "test:unit": "CYPRESS=true cypress run --component",
    "test:unit:debug": "CYPRESS=true cypress open --component",
    "test:e2e": "start-server-and-test 'bun run dev' http-get://localhost:3000/healthz 'bunx cypress run'",
    "test:e2e:fast": "bun run build && AUTH_PROVIDER=fake start-server-and-test 'bun run start' http-get://localhost:3000/healthz 'bunx cypress run --spec cypress/e2e/core-signin.cy.ts'",
    "test:acceptance": "bunx cypress run --spec acceptance/core-signin.acceptance.cy.ts",
    "size": "size-limit",
    "lint:boundaries": "depcruise app --config .dependency-cruiser.cjs",
    "lint:cycles": "madge --circular --extensions ts,tsx app"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.13.0",
    "@conform-to/react": "1.20.2",
    "@conform-to/zod": "1.20.2",
    "@datum-cloud/datum-ui": "^1.7.0",
    "@epic-web/client-hints": "^1.3.9",
    "@hono/node-server": "^2.1.0",
    "@lingui/core": "^6.6.0",
    "@lingui/detect-locale": "^6.6.0",
    "@lingui/react": "^6.6.0",
    "@oslojs/crypto": "^1.0.1",
    "@oslojs/encoding": "^1.1.0",
    "@react-router/node": "^8.3.0",
    "@sentry/react-router": "^10.69.0",
    "@tanstack/react-virtual": "^3.14.9",
    "@zitadel/client": "1.3.1",
    "@zitadel/proto": "1.3.1",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "hono": "4.13.0",
    "isbot": "^5.2.1",
    "js-yaml": "^5.2.3",
    "lucide-react": "^1.28.0",
    "prom-client": "^15.1.3",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0",
    "react-router-hono-server": "^3.0.0",
    "remix-utils": "10.0.0",
    "sonner": "^2.0.7",
    "zod": "^4.4.3"
  },
  "overrides": {
    "axios": "^1.18.0",
    "@opentelemetry/sdk-trace-base": "2.8.0",
    "@opentelemetry/core": "2.8.0",
    "@opentelemetry/resources": "2.8.0",
    "undici": "^7.28.0",
    "form-data": "^4.0.6",
    "dompurify": "^3.4.11",
    "esbuild": "^0.28.1",
    "@hono/node-server": "^2.1.0",
    "@bufbuild/protobuf": "2.13.0"
  },
  "size-limit": [
    {
      "name": "landing page (gzip)",
      "path": [
        "build/client/assets/entry.client-*.js",
        "build/client/assets/root-*.js"
      ],
      "limit": "150 KB",
      "gzip": true
    },
    {
      "name": "app page (gzip)",
      "path": [
        "build/client/assets/entry.client-*.js",
        "build/client/assets/root-*.js",
        "build/client/assets/chunk-*.js",
        "build/client/assets/form-*.js",
        "build/client/assets/schemas-*.js"
      ],
      "limit": "300 KB",
      "gzip": true
    }
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lingui/cli": "^6.6.0",
    "@lingui/vite-plugin": "^6.6.0",
    "@react-router/dev": "^8.3.0",
    "@size-limit/file": "^12.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/cypress": "^10.1.3",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/bun": "^1.3.14",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "axe-core": "^4.12.1",
    "cypress": "^15.20.0",
    "cypress-axe": "^1.7.0",
    "cypress-split": "^1.25.0",
    "dependency-cruiser": "^18.1.1",
    "eslint": "^10.8.0",
    "lefthook": "^2.1.10",
    "madge": "^8.0.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "size-limit": "^12.1.0",
    "start-server-and-test": "^3.0.12",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.0",
    "vite-plugin-babel-macros": "^1.0.6"
  }
}
