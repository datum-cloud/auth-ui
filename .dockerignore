# Reinstalled in the build stage. A host node_modules copied over pnpm's tree
# makes `pnpm prune` stop with ERR_PNPM_ABORTED_REMOVE_MODULES_DIR_NO_TTY.
node_modules
build
.react-router
.git
docs
cypress
# vite.config.ts imports this stub factory at config-load time (even for the prod
# build, though it's only *used* when CYPRESS is set). Re-include just this one file
# so `pnpm build` in the Docker image can resolve the import; the rest of cypress/
# stays excluded.
!cypress/support/vite-cypress-stubs.ts
coverage
.env
.env.*
.claude
