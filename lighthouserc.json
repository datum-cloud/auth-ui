{
  "ci": {
    "collect": {
      "url": [
        "http://localhost:3000/id/",
        "http://localhost:3000/id/login",
        "http://localhost:3000/id/login/password",
        "http://localhost:3000/id/signed-in",
        "http://localhost:3000/id/error",
        "http://localhost:3000/id/logout/success",
        "http://localhost:3000/id/signup",
        "http://localhost:3000/id/signup/password",
        "http://localhost:3000/id/password/reset",
        "http://localhost:3000/id/password/new",
        "http://localhost:3000/id/password/change",
        "http://localhost:3000/id/verify",
        "http://localhost:3000/id/verify/success",
        "http://localhost:3000/id/sso",
        "http://localhost:3000/id/sso/link",
        "http://localhost:3000/id/sso/google/error",
        "http://localhost:3000/id/login/verify/authenticator",
        "http://localhost:3000/id/login/verify/email",
        "http://localhost:3000/id/login/verify/sms",
        "http://localhost:3000/id/login/passkey",
        "http://localhost:3000/id/login/security-key",
        "http://localhost:3000/id/login/mfa",
        "http://localhost:3000/id/setup/authenticator",
        "http://localhost:3000/id/setup/email",
        "http://localhost:3000/id/setup/sms",
        "http://localhost:3000/id/setup/passkey",
        "http://localhost:3000/id/setup/security-key",
        "http://localhost:3000/id/setup/mfa",
        "http://localhost:3000/id/accounts",
        "http://localhost:3000/id/device",
        "http://localhost:3000/id/sso/ldap"
      ],
      "startServerCommand": "bun run start",
      "startServerReadyPattern": "Started server:"
    },
    "assert": {
      "assertions": {
        "categories:performance": ["warn", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 1.0 }],
        "largest-contentful-paint": ["warn", { "maxNumericValue": 2500 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }],
        "first-contentful-paint": ["warn", { "maxNumericValue": 1500 }],
        "total-blocking-time": ["warn", { "maxNumericValue": 200 }]
      }
    }
  }
}
